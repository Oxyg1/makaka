# Куда шлём данные — бэкенд SWAMP
BACKEND_URL=https://swamp.ВАШ-ДОМЕН.com
# Тот же секрет, что в backend/.env (INGEST_SECRET)
INGEST_SECRET=придумай_длинный_секрет

# Источник данных (see.tg, публичный)
POSO_BASE=https://poso.see.tg
COLLECTION_SLUG=KissedFrog
TOP_WHALES=100

# Период прогона в часах. 0 = один прогон и выход (удобно для cron).
SYNC_INTERVAL_HOURS=24

# Telethon (опционально — обогащение username/аватарок топ-холдеров).
# API_ID/API_HASH берутся на https://my.telegram.org → API development tools.
# TG_SESSION_STRING получается через: python session_string.py
TG_API_ID=
TG_API_HASH=
TG_SESSION_STRING=
