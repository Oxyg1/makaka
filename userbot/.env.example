# Куда шлём данные — бэкенд SWAMP
BACKEND_URL=https://swamp.ВАШ-ДОМЕН.com
# Тот же секрет, что в backend/.env (INGEST_SECRET).
# ТОЛЬКО латиница/цифры/дефис — это HTTP-заголовок (ASCII). Сгенерируй:
#   openssl rand -hex 24
INGEST_SECRET=change-me-ascii-only-no-cyrillic

# Telegram (MTProto) — основной источник данных.
# API_ID/API_HASH: https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# Либо телефон для интерактивного входа на первом запуске:
PHONE_NUMBER=+79001234567
# Либо готовая session-строка (python session_string.py) — тогда PHONE не нужен:
TG_SESSION_STRING=

# Коллекция и режим
COLLECTION_SLUG=KissedFrog
MODE=full            # full = все лягушки (холдеры); fast = только на продаже
MAX_NUM=20000        # потолок перебора (реальный тираж определяется автоматически)
RATE_PER_SEC=25      # лимит запросов/сек к Telegram (безопасно ~25-30)
CONCURRENCY=12       # параллельных воркеров
TOP_WHALES=100
BATCH=200            # лягушек в одном POST в бэкенд

# Период прогона в часах. 0 = один прогон и выход (удобно для cron).
SYNC_INTERVAL_HOURS=24

# Для аватарок топ-холдеров (по username)
POSO_BASE=https://poso.see.tg
